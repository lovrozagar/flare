{
	"name": "flare-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.11",
	"workspaces": {
		"packages": [
			"packages/*",
			"consumer/*",
			"e2e",
			"real-world",
			"benchmark",
			"benchmark/flare",
			"ui-test-source",
			"ui-test-prebuilt"
		],
		"catalog": {
			"@axe-core/playwright": "4.12.1",
			"@babel/parser": "8.0.4",
			"@capsizecss/metrics": "4.1.0",
			"@cloudflare/vite-plugin": "1.44.0",
			"@cloudflare/workers-types": "5.20260710.1",
			"@effect/schema": "0.75.5",
			"@formatjs/intl-localematcher": "0.8.11",
			"@playwright/test": "1.61.1",
			"@sinclair/typebox": "0.34.50",
			"@solidjs/testing-library": "0.8.10",
			"@tailwindcss/vite": "4.3.2",
			"@tanstack/solid-query": "5.101.2",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/negotiator": "0.6.4",
			"@types/node": "26.1.1",
			"arktype": "2.2.3",
			"bun-types": "1.3.14",
			"effect": "3.21.4",
			"isbot": "5.2.0",
			"jsdom": "29.1.1",
			"magic-string": "0.30.21",
			"negotiator": "1.0.0",
			"nitro": "3.0.260610-beta",
			"node-html-markdown": "2.0.0",
			"oxc-parser": "0.139.0",
			"oxc-resolver": "11.23.0",
			"sharp": "0.35.3",
			"solid-js": "1.9.14",
			"superstruct": "2.0.2",
			"tailwindcss": "4.3.2",
			"typescript": "7.0.2",
			"valibot": "1.4.2",
			"vite": "8.1.4",
			"vite-plugin-mkcert": "2.1.0",
			"vite-plugin-solid": "2.11.12",
			"vitest": "4.1.10",
			"wrangler": "4.110.0",
			"yup": "1.7.1",
			"zod": "4.3.6"
		}
	},
	"scripts": {
		"test": "bun run --filter flare test",
		"test:cli": "bun run --filter @flare/cli test",
		"test:e2e": "bun run --filter @flare/e2e test",
		"test:watch": "bun run --filter flare test:watch",
		"typecheck": "bun run --filter flare type:check",
		"typecheck:consumers": "bun run --filter @flare/e2e type:check && bun run --filter @flare/real-world type:check"
	}
}
