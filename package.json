{
	"name": "flare-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"e2e/*",
			"e2e/apps/*",
			"benchmark",
			"benchmark/flare"
		],
		"catalog": {
			"@axe-core/playwright": "4.12.1",
			"@babel/parser": "8.0.4",
			"@capsizecss/metrics": "4.1.0",
			"@cloudflare/vite-plugin": "1.44.0",
			"@cloudflare/workers-types": "5.20260710.1",
			"@effect/schema": "0.75.5",
			"@formatjs/intl-localematcher": "0.8.11",
			"@playwright/test": "1.61.1",
			"@sinclair/typebox": "0.34.50",
			"@solidjs/testing-library": "0.8.10",
			"@tailwindcss/vite": "4.3.2",
			"@tanstack/query-broadcast-client-experimental": "5.101.2",
			"@tanstack/solid-query": "5.101.2",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/negotiator": "0.6.4",
			"@types/node": "26.1.1",
			"arktype": "2.2.3",
			"bun-types": "1.3.14",
			"effect": "3.21.4",
			"isbot": "5.2.0",
			"jsdom": "24.1.3",
			"magic-string": "0.30.21",
			"negotiator": "1.0.0",
			"nitro": "3.0.260610-beta",
			"node-html-markdown": "2.0.0",
			"oxc-parser": "0.139.0",
			"oxc-resolver": "11.23.0",
			"sharp": "0.35.3",
			"solid-js": "1.9.14",
			"superstruct": "2.0.2",
			"tailwindcss": "4.3.2",
			"typescript": "7.0.2",
			"valibot": "1.4.2",
			"vite": "8.1.4",
			"vite-plugin-mkcert": "2.1.0",
			"vite-plugin-solid": "2.11.12",
			"vitest": "4.1.10",
			"wrangler": "4.110.0",
			"yup": "1.7.1",
			"zod": "4.3.6"
		}
	},
	"type": "module",
	"scripts": {
		"prepare": "git config --get core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
		"test": "bun run --filter @lovrozagar/flare test",
		"test:all": "bun run scripts/test-all.ts",
		"test:all:full": "bun run scripts/test-all.ts --full",
		"test:cli": "bun run --filter @flare/cli test",
		"test:e2e": "bun run e2e/run-env.ts --env node",
		"test:e2e:bun": "bun run e2e/run-env.ts --env bun",
		"test:e2e:bun:prod": "TEST_MODE=prod bun run e2e/run-env.ts --env bun",
		"test:e2e:deno": "bun run e2e/run-env.ts --env deno",
		"test:e2e:firefox": "bun run e2e/run-env.ts --env firefox",
		"test:e2e:prod": "TEST_MODE=prod bun run e2e/run-env.ts --env node",
		"test:e2e:workers": "bun run e2e/run-env.ts --env workers",
		"test:e2e:workers:prod": "TEST_MODE=prod bun run e2e/run-env.ts --env workers",
		"test:watch": "bun run --filter @lovrozagar/flare test:watch",
		"typecheck": "bun run --filter @lovrozagar/flare type:check",
		"typecheck:consumers": "bun run --filter @flare/e2e-product type:check && bun run --filter @flare/e2e-demo type:check && bun run --filter @flare/e2e-fs-routes type:check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0"
	},
	"packageManager": "bun@1.3.11"
}
