{
	"name": "flare-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"packages/core/tests/e2e/apps/*"
		],
		"catalog": {
			"@axe-core/playwright": "4.12.1",
			"@babel/parser": "8.0.4",
			"@capsizecss/metrics": "4.1.0",
			"@cloudflare/vite-plugin": "1.64.0",
			"@cloudflare/workers-types": "5.20261012.1",
			"@effect/schema": "0.75.5",
			"@formatjs/intl-localematcher": "0.8.11",
			"@playwright/test": "1.64.1",
			"@sinclair/typebox": "0.34.50",
			"@solidjs/testing-library": "1.0.0-beta.3",
			"@solidjs/vite-plugin": "3.0.0-next.51",
			"@solidjs/web": "2.0.0-rc.17",
			"@tailwindcss/vite": "4.3.3",
			"@tanstack/solid-query": "6.0.0-rc.5",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/node": "26.1.1",
			"arktype": "2.2.3",
			"bun-types": "1.3.14",
			"effect": "3.21.4",
			"isbot": "5.2.0",
			"jsdom": "24.1.3",
			"magic-string": "0.30.21",
			"negotiator": "1.0.0",
			"nitro": "3.0.260610-beta",
			"node-html-markdown": "2.0.0",
			"oxc-parser": "0.139.0",
			"oxc-resolver": "11.23.0",
			"sharp": "0.35.5",
			"solid-js": "2.0.0-rc.17",
			"superstruct": "2.0.2",
			"tailwindcss": "4.3.3",
			"tsdown": "0.23.1",
			"typescript": "7.0.2",
			"valibot": "1.4.2",
			"vite": "8.1.4",
			"vite-plugin-mkcert": "2.1.0",
			"vitest": "4.1.10",
			"miniflare": "5.20261012.0-beta",
			"wrangler": "4.151.0",
			"yup": "1.7.1",
			"zod": "4.3.6"
		}
	},
	"type": "module",
	"scripts": {
		"check-tree": "bun scripts/check-tree.ts",
		"dashboard:dev": "bun run --bun --cwd packages/core/tests/e2e/apps/dashboard dev",
		"docs:dev": "bun run --bun --cwd packages/core/tests/e2e/apps/docs dev",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"grunt:antigravity": "antigravity --dangerously-skip-permissions",
		"grunt:claude": "claude --dangerously-skip-permissions",
		"grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"grunt:doctor": "node ./.rulesync/scripts/doctor.mjs",
		"grunt:gemini": "gemini --yolo",
		"grunt:grok": "grok --yolo",
		"grunt:hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
		"grunt:hooks:union": "node .rulesync/scripts/hooks-union.mjs",
		"grunt:purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
		"grunt:purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
		"grunt:rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
		"grunt:rulesync:doctor": "rulesync doctor",
		"grunt:rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
		"grunt:rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
		"grunt:setup": "node ./.rulesync/scripts/setup.mjs",
		"grunt:sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
		"grunt:sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
		"grunt:sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
		"grunt:test:e2e": "vitest run -c vitest.e2e.config.ts",
		"lint": "oxlint && oxlint -c packages/core/.oxlintrc.json packages/core",
		"lint:fix": "oxlint --fix",
		"prepare": "lefthook install --reset-hooks-path",
		"test": "bun run --filter @lovrozagar/flare test",
		"test:bun": "bun --bun run --filter @lovrozagar/flare test:bun",
		"test:e2e": "bunx playwright test -c packages/core/tests/e2e/playwright.config.ts",
		"typecheck": "bun run --filter @lovrozagar/flare type:check && sh -c 'if find packages/core/src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) ! -name \"*.test.ts\" ! -name \"*.test.tsx\" -print -quit 2>/dev/null | grep -q .; then bun run --filter @lovrozagar/flare type:check:src; fi' && bunx tsc -p tsconfig.scripts.json --noEmit && bunx tsc -p packages/core/tests/e2e/apps/docs/tsconfig.json --noEmit && bunx tsc -p packages/core/tests/e2e/apps/dashboard/tsconfig.json --noEmit",
		"verify": "bun scripts/verify.ts",
		"verify:safari": "bun scripts/verify-safari.ts"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@lovrozagar/grunt": "0.11.0",
		"lefthook": "2.2.2",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"rulesync": "16.17.0",
		"smol-toml": "^1.8.0"
	},
	"packageManager": "bun@1.4.3",
	"standards": {
		"repo": "flare",
		"gates": [
			"test:bun",
			"check-tree",
			"test:e2e"
		]
	}
}
