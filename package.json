{
	"name": "flare-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"packages/core/tests/e2e/apps/*"
		],
		"catalog": {
			"@axe-core/playwright": "4.12.1",
			"@babel/parser": "8.0.4",
			"@capsizecss/metrics": "4.1.0",
			"@cloudflare/vite-plugin": "1.44.0",
			"@cloudflare/workers-types": "5.20260710.1",
			"@effect/schema": "0.75.5",
			"@formatjs/intl-localematcher": "0.8.11",
			"@playwright/test": "1.61.1",
			"@sinclair/typebox": "0.34.50",
			"@solidjs/testing-library": "1.0.0-beta.3",
			"@solidjs/vite-plugin": "3.0.0-next.47",
			"@solidjs/web": "2.0.0-rc.13",
			"@tailwindcss/vite": "4.3.3",
			"@tanstack/query-broadcast-client-experimental": "5.104.1",
			"@tanstack/solid-query": "6.0.0-rc.5",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/negotiator": "0.6.4",
			"@types/node": "26.1.1",
			"arktype": "2.2.3",
			"bun-types": "1.3.14",
			"effect": "3.21.4",
			"isbot": "5.2.0",
			"jsdom": "24.1.3",
			"magic-string": "0.30.21",
			"negotiator": "1.0.0",
			"nitro": "3.0.260610-beta",
			"node-html-markdown": "2.0.0",
			"oxc-parser": "0.139.0",
			"oxc-resolver": "11.23.0",
			"sharp": "0.35.3",
			"solid-js": "2.0.0-rc.13",
			"superstruct": "2.0.2",
			"tailwindcss": "4.3.3",
			"typescript": "7.0.2",
			"valibot": "1.4.2",
			"vite": "8.1.4",
			"vite-plugin-mkcert": "2.1.0",
			"vitest": "4.1.10",
			"wrangler": "4.110.0",
			"yup": "1.7.1",
			"zod": "4.3.6"
		}
	},
	"type": "module",
	"scripts": {
		"prepare": "git config --get core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
		"test": "bun run --filter @lovrozagar/flare test",
		"test:e2e": "bunx playwright test -c packages/core/tests/e2e/playwright.config.ts",
		"typecheck": "bun run --filter @lovrozagar/flare type:check && sh -c 'if find packages/core/src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) ! -name \"*.test.ts\" ! -name \"*.test.tsx\" -print -quit 2>/dev/null | grep -q .; then bun run --filter @lovrozagar/flare type:check:src; fi' && bunx tsc -p tsconfig.scripts.json --noEmit",
		"lint": "oxlint && oxlint -c packages/core/.oxlintrc.json packages/core",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0"
	},
	"overrides": {
		"@tanstack/query-core": "5.104.1"
	},
	"packageManager": "bun@1.3.11"
}
