{
	"name": "@flare/real-world",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev --port 5001",
		"preview": "vite preview --port 5001",
		"test": "bunx playwright test",
		"test:all": "bun run test:dev && bun run test:prod",
		"test:dev": "bunx playwright test",
		"test:prod": "bun run build && TEST_MODE=prod bunx playwright test",
		"test:ui": "bunx playwright test --ui",
		"type:check": "tsc --noEmit"
	},
	"dependencies": {
		"flare": "workspace:*",
		"solid-js": "1.9.14",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@types/node": "26.1.1",
		"tailwindcss": "4.3.2",
		"typescript": "7.0.2",
		"vite": "8.1.4",
		"vite-plugin-solid": "2.11.12"
	}
}
