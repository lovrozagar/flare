{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"env": {
		"browser": true,
		"node": true
	},
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/dist/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/.wrangler/**",
		"**/.flare/**",
		"**/.output/**",
		"**/_gen/**",
		// One module per font registry key, written by features/fonts/generate.ts (B78).
		"packages/core/src/features/fonts/shared/generated/**",
		"**/*.gen.ts",
		"**/*.gen.d.ts",
		"**/target/**",
		"_v0/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".githooks/**",
		"scripts/*.mjs",
		"scripts/scrub-text"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"no-underscore-dangle": "off",
		"no-unassigned-vars": "off",
		"require-yield": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "warn"
	},
	"overrides": [
		{
			"files": ["packages/core/tests/**/*.{ts,tsx}"],
			"rules": {
				"typescript/no-explicit-any": "off",
				"no-unsafe-finally": "off"
			}
		}
	]
}
