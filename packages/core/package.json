{
	"name": "@lovrozagar/flare",
	"version": "1.0.0",
	"license": "MIT",
	"bin": {
		"flare": "./src/vite/bin/flare.ts"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/exports/index.ts",
			"default": "./src/exports/index.ts"
		},
		"./client": {
			"types": "./src/exports/client.ts",
			"default": "./src/exports/client.ts"
		},
		"./server": {
			"types": "./src/exports/server.ts",
			"default": "./src/exports/server.ts"
		},
		"./server-fn": {
			"types": "./src/exports/server-fn.ts",
			"workerd": "./src/exports/server-fn.ts",
			"browser": "./src/exports/server-fn-client.ts",
			"worker": "./src/exports/server-fn-client.ts",
			"default": "./src/exports/server-fn.ts"
		},
		"./query": {
			"types": "./src/exports/query.ts",
			"default": "./src/exports/query.ts"
		},
		"./i18n": {
			"types": "./src/exports/i18n.ts",
			"default": "./src/exports/i18n.ts"
		},
		"./i18n/server": {
			"types": "./src/exports/i18n-server.ts",
			"default": "./src/exports/i18n-server.ts"
		},
		"./seo": {
			"types": "./src/exports/seo.ts",
			"default": "./src/exports/seo.ts"
		},
		"./adapters/node": {
			"types": "./src/exports/adapters-node.ts",
			"default": "./src/exports/adapters-node.ts"
		},
		"./adapters/bun": {
			"types": "./src/exports/adapters-bun.ts",
			"default": "./src/exports/adapters-bun.ts"
		},
		"./adapters/workers": {
			"types": "./src/exports/adapters-workers.ts",
			"default": "./src/exports/adapters-workers.ts"
		},
		"./worker": {
			"types": "./src/exports/worker.ts",
			"default": "./src/exports/worker.ts"
		},
		"./stores/fs": {
			"types": "./src/exports/stores-fs.ts",
			"default": "./src/exports/stores-fs.ts"
		},
		"./stores/cache-api": {
			"types": "./src/exports/stores-cache-api.ts",
			"default": "./src/exports/stores-cache-api.ts"
		},
		"./vite": {
			"types": "./src/exports/vite.ts",
			"default": "./src/exports/vite.ts"
		},
		"./fonts/*": "./src/features/fonts/shared/generated/*.ts",
		"./generated": {
			"types": "./src/exports/generated.ts",
			"default": "./src/exports/generated.ts"
		},
		"./testing": {
			"types": "./src/exports/testing.ts",
			"default": "./src/exports/testing.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run --coverage",
		"test:bun": "vitest run",
		"type:check": "tsc -p tsconfig.json --noEmit",
		"type:check:src": "tsc -p tsconfig.src.json --noEmit",
		"fonts:generate": "bun -e \"import('./src/features/fonts/generate.ts').then((generate) => generate.writeFonts('.'))\""
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@cloudflare/vite-plugin": "1.44.0",
		"@formatjs/intl-localematcher": "0.8.11",
		"@mdn/browser-compat-data": "8.1.5",
		"@playwright/test": "1.64.1",
		"@solidjs/vite-plugin": "3.0.0-next.50",
		"@solidjs/web": "2.0.0-rc.15",
		"@tanstack/solid-query": "6.0.0-rc.5",
		"@types/node": "26.1.1",
		"@vitest/coverage-v8": "4.1.10",
		"arktype": "2.2.3",
		"effect": "3.21.4",
		"fflate": "0.8.3",
		"isbot": "5.2.0",
		"js-yaml": "5.3.0",
		"jsdom": "24.1.3",
		"magic-string": "0.30.21",
		"miniflare": "4.20260708.1",
		"negotiator": "1.0.0",
		"oxc-parser": "0.139.0",
		"seroval": "1.6.7",
		"seroval-plugins": "1.6.7",
		"sharp": "0.35.5",
		"solid-js": "2.0.0-rc.15",
		"superstruct": "2.0.2",
		"tsdown": "0.23.1",
		"typebox": "1.3.34",
		"typescript": "7.0.2",
		"valibot": "1.5.0",
		"vite": "8.1.4",
		"vitest": "4.1.10",
		"zod": "4.3.6"
	},
	"peerDependencies": {
		"@formatjs/intl-localematcher": ">=0.8.11",
		"@solidjs/vite-plugin": ">=3.0.0-next.50",
		"@solidjs/web": ">=2.0.0-rc.15",
		"@tanstack/solid-query": ">=6.0.0-rc.5",
		"isbot": ">=5.2.0",
		"magic-string": ">=0.30.21",
		"negotiator": ">=1.0.0",
		"oxc-parser": ">=0.139.0",
		"seroval": ">=1.6.7",
		"seroval-plugins": ">=1.6.7",
		"sharp": ">=0.35.5",
		"solid-js": ">=2.0.0-rc.15",
		"vite": ">=8.1.4"
	},
	"peerDependenciesMeta": {
		"@formatjs/intl-localematcher": {
			"optional": true
		},
		"@tanstack/solid-query": {
			"optional": true
		},
		"isbot": {
			"optional": true
		},
		"negotiator": {
			"optional": true
		},
		"sharp": {
			"optional": true
		}
	}
}
