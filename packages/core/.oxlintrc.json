{
	"$schema": "../../../node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "vitest"],
	"jsPlugins": [{ "name": "flare", "specifier": "./lint/boundaries.js" }],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"complexity": ["error", 15],
		"max-depth": ["error", 4],
		"max-lines": ["error", 300],
		"max-lines-per-function": ["error", 60],
		"max-params": ["error", 3],
		"vitest/expect-expect": [
			"error",
			{ "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType", "expectReported"] }
		],
		"vitest/no-conditional-expect": "error",
		"vitest/no-focused-tests": "error",
		"vitest/no-disabled-tests": "error",
		"flare/boundaries": "error",
		"flare/no-module-side-effects": "error",
		"flare/no-module-state": "error",
		"flare/no-v8-ignore": "error",
		"flare/path-prefix": "error",
		"flare/location-only-in-redirect": "error",
		"flare/funnel-only": "error",
		"flare/no-flare-header-branching": "error",
		"unicorn/consistent-function-scoping": "error"
	},
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.test.tsx"],
			"rules": {
				"max-lines": ["error", 500],
				"flare/funnel-only": "off",
				"flare/no-flare-header-branching": "off"
			}
		},
		{
			"files": ["tests/**"],
			"rules": {
				"flare/no-flare-header-branching": "off"
			}
		},
		{
			"files": ["tests/types/*/src/sections/*.types.ts"],
			"rules": {
				"flare/no-module-side-effects": "off",
				"flare/funnel-only": "off",
				"vitest/expect-expect": "off"
			}
		},
		{
			"files": ["tests/*.setup.ts", "tests/integration/*.setup.ts", "tests/integration/*.probe.mjs"],
			"rules": {
				"flare/no-module-side-effects": "off"
			}
		},
		{
			"files": ["tests/e2e/apps/**", "tests/perf/apps/**"],
			"rules": {
				"flare/no-module-side-effects": "off",
				"flare/funnel-only": "off"
			}
		},
		{
			"files": ["tests/e2e/**"],
			"plugins": ["typescript", "unicorn", "oxc"],
			"rules": {
				"vitest/expect-expect": "off",
				"vitest/no-conditional-expect": "off",
				"vitest/no-focused-tests": "off",
				"vitest/no-disabled-tests": "off"
			}
		}
	]
}
