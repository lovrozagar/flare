{
	"name": "docs",
	// flare's worker entry: the app's server behind the Workers adapter (B109).
	"main": "@lovrozagar/flare/worker",
	"compatibility_date": "2026-07-01",
	// `enable_request_signal`: a client that stops a stream aborts the worker's `request.signal` (dx/adapters.md).
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	// The built client. flare's worker entry forwards an unmatched GET to this binding (dx/adapters.md).
	"assets": { "binding": "ASSETS", "directory": "dist/client" },
}
