{
	"extends": "../../../../../tsconfig.base.json",
	"compilerOptions": {
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"noPropertyAccessFromIndexSignature": true,
		"noEmit": true,
		"jsx": "preserve",
