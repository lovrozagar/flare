{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true
	},
	"include": ["src/**/*", "tests/**/*", "lint/**/*.ts"],
	// The types fixtures compile under their own tsconfigs, the app with a generated register, the hand-written one with
	// its own, and the unregistered one with none (tests/types/app.test.ts). So do the
	// docs app, with its own FlareRegister augmentation and the integration test over its router (B94), and the
	// dashboard app (B146). An e2e app's generated register belongs to that app, not to the package's own tests. The
	// consumer fixture compiles against the packed types only (tests/structure/exports.test.ts).
	"exclude": [
		"tests/types/app/**",
		"tests/types/handwritten/**",
		"tests/types/unregistered/**",
		"tests/e2e/apps/*/src/_gen/types.gen.ts",
		"tests/perf/apps/*/src/_gen/types.gen.ts",
		"tests/structure/consumer/**",
		"tests/e2e/apps/docs/**",
		"tests/e2e/apps/dashboard/**",
		"tests/integration/docs.test.ts"
	]
}
