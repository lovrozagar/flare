{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true
	},
	"include": ["src/**/*", "tests/**/*", "lint/**/*.ts"]
}
