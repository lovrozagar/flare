{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true
	},
	"include": ["src/**/*", "tests/**/*", "lint/**/*.ts"],
	// The types fixture compiles under its own tsconfig with a generated register (tests/types/app.test.ts). An e2e
	// app's generated register belongs to that app, not to the package's own tests.
	"exclude": ["tests/types/app/**", "tests/e2e/apps/*/src/_gen/types.gen.d.ts"]
}
