{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true
	},
	"include": ["src/**/*", "tests/**/*", "lint/**/*.ts"],
	// The types fixture compiles under its own tsconfig with a generated register (tests/types/app.test.ts). So does the
	// docs app, with its own FlareRegister augmentation and the integration test over its router (B94). An e2e
	// app's generated register belongs to that app, not to the package's own tests. The consumer fixture compiles against
	// the packed types only (tests/structure/exports.test.ts).
	"exclude": [
		"tests/types/app/**",
		"tests/e2e/apps/*/src/_gen/types.gen.d.ts",
		"tests/structure/consumer/**",
		"tests/e2e/apps/docs/**",
		"tests/integration/docs.test.ts"
	]
}
