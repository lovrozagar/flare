{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true
	},
	"include": ["src/**/*", "tests/**/*", "lint/**/*.ts"],
	// The types fixture compiles under its own tsconfig with a generated register (tests/types/app.test.ts).
	"exclude": ["tests/types/app/**"]
}
