{
	"name": "@flare/e2e-workers",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run dev:kill && bunx vite dev --port 4104 --config ../apps/product/vite.workers.config.ts",
		"dev:kill": "lsof -ti:4104,4108 2>/dev/null | xargs -r kill -9 2>/dev/null || true",
		"test": "bun run dev:kill && playwright test",
		"test:prod": "bun run dev:kill && TEST_MODE=prod playwright test",
		"type:check": "tsc --noEmit"
	},
	"dependencies": {
		"@flare/e2e-product": "workspace:*",
		"@lovrozagar/flare": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "catalog:",
		"@cloudflare/vite-plugin": "catalog:",
		"@cloudflare/workers-types": "catalog:",
		"@playwright/test": "catalog:",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
