{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/dist/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/.wrangler/**",
		"**/.flare/**",
		"**/.output/**",
		"**/_gen/**",
		"**/*.gen.ts",
		"**/*.gen.d.ts",
		"**/target/**",
		"e2e/apps/tauri/src-tauri/**",
		"*.lock",
		"**/package-lock.json",
	],
}
