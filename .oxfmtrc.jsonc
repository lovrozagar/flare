{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/dist/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/_gen/**",
		"*.lock",
		".tmp/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".mcp.json",
		"AGENTS.md",
		"CLAUDE.md",
		"GEMINI.md",
		".oxfmtrc.jsonc",
		"**/.wrangler/**",
		"**/.flare/**",
		"**/.output/**",
		"packages/core/src/features/fonts/shared/generated/**",
		"**/*.gen.ts",
		"**/*.gen.d.ts",
		"**/target/**",
		"_v0/**",
		"blueprint/**",
		"TODO*.md",
		"**/package-lock.json",
		"package.json"
	]
}
