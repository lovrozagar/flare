{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/dist/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/.wrangler/**",
		"**/.flare/**",
		"**/.output/**",
		"**/_gen/**",
		// One module per font registry key, written by features/fonts/generate.ts (B78).
		"packages/core/src/features/fonts/shared/generated/**",
		"**/*.gen.ts",
		"**/*.gen.d.ts",
		"**/target/**",
		"_v0/**",
		"blueprint/**",
		"TODO*.md",
		"*.lock",
		"**/package-lock.json",
		// Written by the grunt harness and rulesync in their own format. Reformatting them fights every regenerate.
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".githooks/**",
		"AGENTS.md",
		"CLAUDE.md",
		"GEMINI.md",
		".mcp.json",
		"package.json",
	],
}
