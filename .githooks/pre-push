#!/usr/bin/env bash
# pre-push — every pushed commit passed every gate.
#
# `bun run verify` stamps a commit in flare-verified/<sha> of the repository's common git dir once all seven local
# gates pass on it (scripts/verify.ts, AGENTS.md "Every gate passes before moving on"); every worktree shares that dir.
# This hook refuses a push while any commit it would send has no stamp. A branch deletion sends no commit. The root
# package's `prepare` points core.hooksPath here on `bun install` in this repo; the published package has no hooks.
#
# Never bypass it: a commit without a stamp gets `bun run verify`.

set -u

remote="${1:-origin}"
common="$(git rev-parse --path-format=absolute --git-common-dir)"
stamps="$common/flare-verified"
missing=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac
	# A new branch, or a remote tip this clone does not have, sends what no remote-tracking branch already holds.
	if [ -n "${remote_sha//0/}" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		commits="$(git rev-list "$remote_sha..$local_sha")"
	else
		commits="$(git rev-list "$local_sha" --not --remotes="$remote")"
	fi
	for sha in $commits; do
		[ -f "$stamps/$sha" ] || missing="$missing $sha"
	done
done

if [ -n "$missing" ]; then
	printf '\n✖ push refused: these commits have no verify stamp in %s\n\n' "$stamps" >&2
	for sha in $missing; do printf '  %s\n' "$(git log -1 --format='%h %s' "$sha")" >&2; done
	printf '\nCheck out each one on a clean tree and run `bun run verify`; it stamps the commit when every gate passes.\n\n' >&2
	exit 1
fi
