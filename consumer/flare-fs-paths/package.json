{
	"name": "flare-fs-paths",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:cf": "vite build --config vite.cf.config.ts",
		"deploy": "bun run build:cf && wrangler deploy",
		"dev": "vite dev --port 4111",
		"generate": "flare codegen --fs",
		"test": "lsof -ti:4111,4112 2>/dev/null | xargs -r kill -9 2>/dev/null || true; playwright test",
		"test:cf": "playwright test --config playwright.cf.config.ts",
		"test:prod": "lsof -ti:4111,4112 2>/dev/null | xargs -r kill -9 2>/dev/null || true; TEST_MODE=prod playwright test"
	},
	"dependencies": {
		"flare": "workspace:*",
		"solid-js": "catalog:",
		"vite": "catalog:",
		"vite-plugin-solid": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "catalog:",
		"@flare/cli": "workspace:*",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
